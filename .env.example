# ==============================================================================
# INDUSTRIAL BRAIN — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application Environment
NODE_ENV="development"
PORT="3000"
APP_NAME="Industrial Brain"
APP_VERSION="1.0.0"

# AI Studio injected environment variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# Security & Authentication
# CRITICAL: In production, generate cryptographically random 64-char keys
JWT_SECRET="industrial-brain-jwt-secret-replace-in-production-min-32-chars-long"
JWT_EXPIRATION_HOURS="24"
AUDIT_HMAC_KEY="audit-hmac-tamper-evident-secret-replace-in-production"

# Database Configuration (PostgreSQL 16+)
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_DB="industrial_brain"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="secure_postgres_password_here"
DATABASE_URL="postgresql://postgres:secure_postgres_password_here@localhost:5432/industrial_brain"

# Redis Cache & Background Queue
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_URL="redis://localhost:6379/0"

# Security Controls & Policy Engine Defaults
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
MAX_REQUEST_SIZE_MB="50"
RATE_LIMIT_MAX_PER_MINUTE="120"
TENANT_ISOLATION_STRICT="true"
AUDIT_CHECKSUM_ENFORCED="true"
